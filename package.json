{
  "name": "poker-planning-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "coverage": "turbo coverage",
    "clean": "turbo clean && rm -rf node_modules",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.6",
    "lint-staged": "^15.4.3",
    "turbo": "^2.7.5"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.7",
      "@types/react-dom": "19.2.3"
    },
    "ignoredBuiltDependencies": [
      "@sentry/cli",
      "@swc/core",
      "core-js-pure",
      "msw",
      "sharp",
      "unrs-resolver"
    ],
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
